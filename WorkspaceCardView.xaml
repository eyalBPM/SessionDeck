<UserControl x:Class="SessionDeck.WorkspaceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisibleInDeck}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border x:Name="RootBorder"
            BorderBrush="{Binding CardBrush}" BorderThickness="2" CornerRadius="8"
            Background="#FF1E1E1E" Margin="8" MinWidth="380" Cursor="Hand"
            MouseLeftButtonUp="Card_MouseUp">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Hidden}" Value="True">
                        <Setter Property="Opacity" Value="0.55"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <!-- header: project name + branch + actions, tinted with the card color -->
            <Grid DockPanel.Dock="Top">
                <Border Background="{Binding CardBrush}" Opacity="0.25" CornerRadius="6,6,0,0"/>
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontWeight="Bold"
                                       FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                       ToolTip="{Binding Path}"/>
                            <Border Background="#33FFFFFF" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBranch}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="#FFDDDDDD" FontSize="11">
                                    <Run Text="&#x2387;"/> <Run Text="{Binding Branch}"/>
                                </TextBlock>
                            </Border>
                            <!-- open Claude Code tabs, reported by the VSCode extension (stage D) -->
                            <Border Background="#33FFFFFF" CornerRadius="8" Padding="7,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center" ToolTip="{Binding ClaudeTabsTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClaudeTabs}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Foreground="#FFDDDDDD" FontSize="11">
                                    <Run Text="📑"/> <Run Text="{Binding ClaudeTabCount, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="#FFAAAAAA" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Description}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button Content="✏" Click="Edit_Click" ToolTip="ערוך כרטיס"/>
                        <Button Content="▶" Click="Pin_Click" ToolTip="פתח את החלון באזור הפתיחה המוגדר"/>
                        <Button x:Name="ExpandButton" Content="▼" Click="Expand_Click"
                                ToolTip="הצג גם סשנים סגורים"/>
                        <Button x:Name="HideButton" Content="🗕" Click="Hide_Click"/>
                        <Button Content="✕" Click="Remove_Click" Foreground="#FFCC7777"
                                ToolTip="הסר workspace מהלוח"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- session cards (SPEC §2ב): status-colored borders, no thumbnails -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Sessions}" Margin="8,2,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding BorderBrush}" BorderThickness="2" CornerRadius="5"
                                Background="#FF262626" Margin="0,3" Padding="8,4" Cursor="Hand"
                                MouseLeftButtonUp="Session_MouseUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Closed}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid ToolTip="{Binding TooltipText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubText}" Foreground="#FF999999" FontSize="10"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SubText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <TextBlock Text="📑" FontSize="11" Margin="0,0,6,0"
                                               ToolTip="פתוח כטאב ב-VSCode">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OpenAsTab}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#FFBBBBBB" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- live DWM thumbnail of the bound VSCode window -->
            <Grid Height="170">
                <Border x:Name="ThumbArea" Background="#FF0D0D0D" Margin="8,6,8,2" CornerRadius="4"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔌 אין חלון VSCode פתוח" Foreground="#FF888888" FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="לחץ כדי לפתוח את הפרויקט ב-VSCode" Foreground="#FF555555" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
