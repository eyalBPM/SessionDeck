<Window x:Class="SessionDeck.TogglesEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מתגים אישיים" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#FF222222">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#FF999999"
                   Text="כל מתג מופיע ככפתור ב-toolbar. המצב (1/0) נכתב לקובץ בשם המזהה תחת %APPDATA%\SessionDeck\toggles — משם סקריפטים ו-hooks חיצוניים קוראים אותו."/>

        <!-- header -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="אייקון" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="מזהה (id)" FontSize="11"/>
            <TextBlock Grid.Column="2" Text="תיאור (tooltip)" FontSize="11"/>
            <TextBlock Grid.Column="3" Text="ברירת מחדל" FontSize="11" ToolTip="המצב ההתחלתי כשעדיין אין קובץ דגל"/>
        </Grid>

        <ItemsControl x:Name="TogglesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center" Margin="0,0,6,0"/>
                        <!-- id doubles as the flag file name — English/LTR -->
                        <TextBox Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="2" Text="{Binding Tooltip, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Grid.Column="3" IsChecked="{Binding DefaultOn}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="4" Content="🗑" ToolTip="מחק מתג" Click="DeleteRow_Click"
                                Background="Transparent" Foreground="#FFCC6666" BorderThickness="0"
                                Cursor="Hand" FontSize="13"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="+ הוסף מתג" Click="Add_Click" HorizontalAlignment="Right" Margin="0,4,0,0"
                Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="אישור" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="ביטול" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
