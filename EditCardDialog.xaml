<Window x:Class="SessionDeck.EditCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עריכת כרטיס" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#FF222222">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <CheckBox x:Name="AutoTitleCheck" Content="כותרת אוטומטית" Checked="AutoTitle_Changed" Unchecked="AutoTitle_Changed"/>
        <TextBlock Text="כותרת:"/>
        <TextBox x:Name="TitleBox"/>
        <TextBlock Text="תיאור:"/>
        <TextBox x:Name="DescBox"/>
        <StackPanel x:Name="ColorSection">
            <CheckBox x:Name="AutoColorCheck" Content="צבע אוטומטי (Peacock / ברירת מחדל)"
                      Checked="AutoColor_Changed" Unchecked="AutoColor_Changed"/>
            <TextBlock Text="צבע כרטיס (שם או ‎#RRGGBB‎):"/>
            <DockPanel Margin="0,0,0,10">
                <Border x:Name="ColorPreview" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="3"
                        BorderBrush="#FF555555" BorderThickness="1" Margin="0,0,8,0"/>
                <TextBox x:Name="ColorBox" Margin="0" TextChanged="Color_Changed"/>
            </DockPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="אישור" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="ביטול" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
