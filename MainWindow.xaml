<Window x:Class="WinGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinGrid"
        Title="WinGrid" Height="700" Width="1100"
        Background="#FF161616">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF232323" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border x:Name="PickerGrip" Background="#FF3A3A3A" CornerRadius="4" Padding="10,4"
                            Cursor="Cross" ToolTip="גרור אותי אל חלון ושחרר כדי להוסיף אריח"
                            MouseLeftButtonDown="PickerGrip_MouseDown" MouseLeftButtonUp="PickerGrip_MouseUp">
                        <TextBlock Text="⌖ בחר חלון" Foreground="White"/>
                    </Border>

                    <TextBlock Text="Zone:" Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ZoneMonitorCombo" Width="110" SelectionChanged="ZoneUi_Changed"/>
                    <ComboBox x:Name="ZoneModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="ZoneUi_Changed"/>

                    <TextBlock Text="אזור פתיחה:" Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"
                               ToolTip="לאן החלון ייפתח בלחיצה על ▶ (Stage)"/>
                    <ComboBox x:Name="StageMonitorCombo" Width="110" SelectionChanged="StageUi_Changed"/>
                    <ComboBox x:Name="StageModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="StageUi_Changed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="StatusText" Foreground="#FF999999"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="SettingsButton" Content="⚙" FontSize="15" ToolTip="הגדרות"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="8,2" Cursor="Hand" Click="Settings_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="StartupMenuItem" Header="עלייה אוטומטית עם Windows"
                                          IsCheckable="True" Click="StartupMenuItem_Click"/>
                                <MenuItem x:Name="AutoRemoveMenuItem" Header="הסר אריח אוטומטית כשהחלון נסגר"
                                          IsCheckable="True" Click="AutoRemoveMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ItemsControl x:Name="TilesHost" ItemsSource="{Binding Tiles}" SizeChanged="TilesHost_SizeChanged">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:TileView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FF666666" FontSize="15" TextAlignment="Center"
                       Text="אין אריחים עדיין&#10;גרור את ⌖ מהסרגל אל חלון, גרור חלון אמיתי ושחרר מעליי,&#10;או הרץ: wingrid add --match &quot;&lt;title regex&gt;&quot;"/>
        </Grid>
    </DockPanel>
</Window>
