<Window x:Class="SessionDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionDeck"
        xmlns:services="clr-namespace:SessionDeck.Services"
        Title="SessionDeck" Height="700" Width="1100"
        Background="#FF161616">
    <Window.Resources>
        <!-- the "Rtl" converter now lives in App.xaml (shared by every window/dialog) -->
        <!-- toolbar icon toggle: accent background while checked (pressed-state UI) -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF333333"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF3A6EA5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF232323" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="AddWorkspaceButton" Click="AddWorkspace_Click" Cursor="Hand"
                            Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="10,4"
                            ToolTip="בחר תיקיית פרויקט להוספה ללוח">
                        <TextBlock Text="+ הוסף Workspace"/>
                    </Button>

                    <TextBlock Text="Zone:" Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ZoneMonitorCombo" Width="110" SelectionChanged="ZoneUi_Changed"/>
                    <ComboBox x:Name="ZoneModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="ZoneUi_Changed"/>

                    <TextBlock Text="אזור פתיחה:" FlowDirection="RightToLeft"
                               Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"
                               ToolTip="לאן החלון ייפתח בלחיצה על ▶ (Stage)"/>
                    <ComboBox x:Name="StageMonitorCombo" Width="110" SelectionChanged="StageUi_Changed"/>
                    <ComboBox x:Name="StageModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="StageUi_Changed"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <!-- user-defined toggles (config: customToggles) — state exported to
                         flag files for external processes to read -->
                    <ItemsControl ItemsSource="{Binding CustomToggles}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Icon}" FontSize="13"
                                              ToolTip="{Binding Tooltip}"
                                              Style="{StaticResource IconToggle}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- divider between user flags and the built-in toolbar toggles;
                         hidden when no flags are defined -->
                    <Border Width="1" Margin="6,3" Background="#FF3E3E3E">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomToggles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <ToggleButton x:Name="ShowHiddenToggle" Content="👁" FontSize="13"
                                  ToolTip="הצג גם workspaces מוסתרים"
                                  Style="{StaticResource IconToggle}"
                                  Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed"/>
                    <ToggleButton x:Name="PinTopToggle" Content="📌" FontSize="13"
                                  ToolTip="נעץ: החלון תמיד עליון (Always on Top)"
                                  Style="{StaticResource IconToggle}"
                                  Checked="PinTop_Changed" Unchecked="PinTop_Changed"/>
                    <ToggleButton x:Name="SearchToggleButton" Content="🔍" FontSize="13"
                                  ToolTip="חיפוש וסינון"
                                  Style="{StaticResource IconToggle}"
                                  Checked="SearchToggle_Changed" Unchecked="SearchToggle_Changed"/>
                    <Button x:Name="SettingsButton" Content="⚙" FontSize="15" ToolTip="הגדרות"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="8,2" Cursor="Hand" Click="Settings_Click">
                        <Button.ContextMenu>
                            <ContextMenu FlowDirection="RightToLeft">
                                <MenuItem x:Name="StartupMenuItem" Header="עלייה אוטומטית עם Windows"
                                          IsCheckable="True" Click="StartupMenuItem_Click"/>
                                <MenuItem x:Name="MaximizeSessionMenuItem" Header="צמצום הפנלים ב-VSCode בפתיחת session"
                                          IsCheckable="True" Click="MaximizeSessionMenuItem_Click"
                                          ToolTip="בלחיצה על session מהלוח: סגור את הפנלים הצדדיים והתחתון כך שהטאב יתפוס את כל האזור"/>
                                <MenuItem x:Name="NotificationsMenuItem" Header="התראות Windows"
                                          IsCheckable="True" Click="NotificationsMenuItem_Click"
                                          ToolTip="כשדולק: סשן שדורש תשומת לב מפיק התראת Windows, נקודה צבעונית על האייקון בשורת המשימות והבהוב חד-פעמי.&#10;פועל רק כשגם 📌 וגם ה-Zone כבויים — בכל מצב אחר הדק גלוי ממילא, וההבהוב בכרטיס מספיק.&#10;גם אז, כשהדק בפוקוס לא תוצג התראה."/>
                                <Separator/>
                                <MenuItem Header="מתגים (Flags)..." Click="TogglesMenuItem_Click"
                                          ToolTip="כפתורי toggle ב-toolbar שמצבם נכתב לקובץ flag — לשליטה בתהליכים חיצוניים"/>
                                <Separator/>
                                <MenuItem x:Name="VersionMenuItem" IsEnabled="False"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- search / filter row (feature 2026-07-19): toggled by the 🔍 button; filters
             workspaces + sessions by title/detail, optionally also by transcript content -->
        <Border x:Name="SearchRow" DockPanel.Dock="Top" Background="#FF1B1B1B" Padding="8,5"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="סגור את שורת החיפוש"
                        Background="Transparent" Foreground="#FFAAAAAA" BorderThickness="0"
                        Padding="8,2" Cursor="Hand" Click="SearchClose_Click"/>
                <CheckBox x:Name="SearchContentCheck" DockPanel.Dock="Right" Content="חפש גם בתוכן"
                          Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="14,0,6,0"
                          FlowDirection="RightToLeft"
                          Checked="SearchContent_Changed" Unchecked="SearchContent_Changed"
                          ToolTip="חפש גם בתוך קבצי ה-transcript של הסשנים (jsonl)"/>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" FontSize="13"
                         Background="#FF2A2A2A" Foreground="White" BorderBrush="#FF444444"
                         CaretBrush="White" Padding="6,3"
                         TextChanged="Search_Changed" KeyDown="SearchBox_KeyDown"/>
            </DockPanel>
        </Border>

        <!-- status bar: full width at the window bottom, outside the scroll area, so long
             messages never crowd the toolbar (feedback 2026-07-19) -->
        <Border DockPanel.Dock="Bottom" Background="#FF232323" Padding="10,4">
            <DockPanel LastChildFill="True">
                <!-- session-status summary (feature 2026-07-19): a dot per (status, blinking)
                     group, colored like the session borders; empty groups are not shown.
                     RTL panel so the most urgent group renders rightmost. -->
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding StatusSummary}"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              FlowDirection="RightToLeft">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0"
                                        ToolTip="{Binding Tooltip}">
                                <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Count}" Foreground="#FFBBBBBB" FontSize="11"
                                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StatusText" Foreground="#FF999999" TextWrapping="Wrap"
                           FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:WorkspaceCardView Width="430"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FF666666" FontSize="15" TextAlignment="Center"
                       FlowDirection="RightToLeft"
                       Text="הלוח ריק&#10;לחץ על ״+ הוסף Workspace״ ובחר תיקיית פרויקט,&#10;או הפעל session של Claude Code עם ה-hooks (ראה תיקיית hooks)"/>
        </Grid>
    </DockPanel>
</Window>
