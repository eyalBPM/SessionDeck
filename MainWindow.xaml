<Window x:Class="SessionDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionDeck"
        Title="SessionDeck" Height="700" Width="1100"
        Background="#FF161616">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF232323" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="AddWorkspaceButton" Click="AddWorkspace_Click" Cursor="Hand"
                            Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="10,4"
                            ToolTip="בחר תיקיית פרויקט להוספה ללוח">
                        <TextBlock Text="+ הוסף Workspace"/>
                    </Button>

                    <TextBlock Text="Zone:" Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ZoneMonitorCombo" Width="110" SelectionChanged="ZoneUi_Changed"/>
                    <ComboBox x:Name="ZoneModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="ZoneUi_Changed"/>

                    <TextBlock Text="אזור פתיחה:" Foreground="#FFBBBBBB" Margin="18,0,6,0" VerticalAlignment="Center"
                               ToolTip="לאן החלון ייפתח בלחיצה על ▶ (Stage)"/>
                    <ComboBox x:Name="StageMonitorCombo" Width="110" SelectionChanged="StageUi_Changed"/>
                    <ComboBox x:Name="StageModeCombo" Width="110" Margin="4,0,0,0" SelectionChanged="StageUi_Changed"/>

                    <ToggleButton x:Name="ShowHiddenToggle" Margin="18,0,0,0" Padding="8,3" Cursor="Hand"
                                  Background="#FF3A3A3A" Foreground="White" BorderThickness="0"
                                  Checked="ShowHidden_Changed" Unchecked="ShowHidden_Changed"
                                  ToolTip="הצג גם workspaces מוסתרים">
                        <TextBlock Text="👁 מוסתרים"/>
                    </ToggleButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="StatusText" Foreground="#FF999999"
                               VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="SettingsButton" Content="⚙" FontSize="15" ToolTip="הגדרות"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            Padding="8,2" Cursor="Hand" Click="Settings_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="StartupMenuItem" Header="עלייה אוטומטית עם Windows"
                                          IsCheckable="True" Click="StartupMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:WorkspaceCardView Width="430"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="#FF666666" FontSize="15" TextAlignment="Center"
                       Text="הלוח ריק&#10;לחץ על ״+ הוסף Workspace״ ובחר תיקיית פרויקט,&#10;או הפעל session של Claude Code עם ה-hooks (ראה תיקיית hooks)"/>
        </Grid>
    </DockPanel>
</Window>
