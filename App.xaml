<Application x:Class="SessionDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SessionDeck"
             xmlns:services="clr-namespace:SessionDeck.Services"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Hebrew-first text renders RTL and right-aligned; anything else stays LTR.
             App-level so every window and dialog shares the one converter instance. -->
        <services:FlowDirectionConverter x:Key="Rtl"/>

        <!-- Standing rule (feedback 2026-07-20): ANY text that may start with Hebrew must
             be direction-aware. Tooltips are the easy thing to forget — they're written
             inline all over the app — so the default style handles every one of them. -->
        <Style TargetType="ToolTip">
            <Setter Property="FlowDirection"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
        </Style>

        <!-- Menu items likewise: headers are Hebrew throughout. -->
        <Style TargetType="MenuItem">
            <Setter Property="FlowDirection"
                    Value="{Binding Header, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
        </Style>

        <!-- ===== Shared dark theme tokens (style pass 2026-07-21) ===== -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3A6EA5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4A80B8"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF315D8C"/>
        <SolidColorBrush x:Key="ControlBgBrush" Color="#FF2A2A2A"/>
        <SolidColorBrush x:Key="ControlBgHoverBrush" Color="#FF313131"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF454545"/>
        <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#FF5E5E5E"/>
        <SolidColorBrush x:Key="PopupBgBrush" Color="#FF242424"/>

        <!-- Primary (accent) button: rounded, hover/pressed states. The default WPF
             button chrome ignores CornerRadius, hence the template. -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox: the default Windows chrome (white gradient + square popup)
             clashes with the app theme. Items are direction-aware per the standing
             Hebrew-RTL rule. Non-editable combos only (the app has no editable ones). -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FlowDirection"
                    Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource Rtl}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                Margin="4,1" Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="4"/>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- selection box: direction follows the selected item's text -->
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  FlowDirection="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Rtl}}"
                                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4.5 L 8 0"
                                      Stroke="#FF9A9A9A" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="7,1,1,0"/>
                            </Grid>
                            <!-- transparent hit area that opens/closes the dropdown -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{StaticResource PopupBgBrush}"
                                        BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,3,8,8" Padding="0,3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBgHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ControlBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
