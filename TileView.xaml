<UserControl x:Class="WinGrid.TileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            BorderBrush="{Binding BorderBrush}" BorderThickness="3" CornerRadius="6"
            Background="#FF1E1E1E" Margin="6"
            MouseLeftButtonDown="Root_MouseDown" MouseLeftButtonUp="Root_MouseUp" MouseMove="Root_MouseMove">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="#CC2A2A2A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="8,4">
                    <StackPanel.ToolTip>
                        <StackPanel>
                            <TextBlock>
                                <Run Text="{Binding Title}"/> (<Run Text="{Binding ProcessName}"/>)
                            </TextBlock>
                            <TextBlock Text="{Binding Description}"/>
                        </StackPanel>
                    </StackPanel.ToolTip>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}" Foreground="#FF999999" FontSize="11"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="✏" Click="Edit_Click" ToolTip="ערוך אריח"
                        Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
                <Button Grid.Column="2" Content="📌" Click="Pin_Click" ToolTip="Pin ל-Stage"
                        Background="Transparent" Foreground="White" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
                <Button Grid.Column="3" Content="✕" Click="Remove_Click" ToolTip="הסר אריח"
                        Background="Transparent" Foreground="#FFCC7777" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
            </Grid>
            <Grid>
                <!-- DWM thumbnail is composited by Windows over this area -->
                <Border x:Name="ThumbArea" Background="#FF0D0D0D"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Disconnected">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔌 מנותק" Foreground="#FF999999" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ProcessName}" Foreground="#FF666666" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="ממתין לחלון תואם..." Foreground="#FF555555" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
