<Window x:Class="SessionDeck.ZoneSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="גודל Zone מותאם" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft" Background="#FF222222">
    <StackPanel Margin="16">
        <TextBlock Text="רוחב ה-Zone מתוך רוחב המסך:" Foreground="#FFCCCCCC" Margin="0,0,0,4"/>
        <TextBox x:Name="SizeBox" FlowDirection="LeftToRight" TextChanged="Size_Changed"
                 Background="#FF333333" Foreground="White" BorderBrush="#FF555555" Padding="4,2"/>
        <TextBlock Text="שבר כמו ‎2/7‎, אחוז כמו ‎40%‎, או עשרוני כמו ‎0.4‎ (בין 5% ל-100%)"
                   Foreground="#FF888888" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock x:Name="PreviewText" Foreground="#FF7FB2E5" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="אישור" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#FF3A6EA5" Foreground="White" BorderThickness="0" Padding="0,5"/>
            <Button Content="ביטול" Width="90" IsCancel="True"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0" Padding="0,5"/>
        </StackPanel>
    </StackPanel>
</Window>
